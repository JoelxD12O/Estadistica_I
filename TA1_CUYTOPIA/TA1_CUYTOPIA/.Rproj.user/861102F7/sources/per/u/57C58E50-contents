# 3. COEFICIENTE DE VARIACIÓN
# ----------------------------------------

promedio_largo <- mean(DF$Largo, na.rm = TRUE)
desv_largo <- sd(DF$Largo, na.rm = TRUE)

cv_largo <- (desv_largo / promedio_largo) * 100

cat("Coeficiente de variación:", round(cv_largo, 2), "%\n")


# ----------------------------------------
# 4. INTERPRETACIÓN
# ----------------------------------------

# Forma
if(abs(promedio_largo - median(DF$Largo, na.rm = TRUE)) < 1){
  forma_largo <- "relativamente concentrada alrededor de la mediana"
} else if(promedio_largo > median(DF$Largo, na.rm = TRUE)){
  forma_largo <- "a la derecha de la mediana"
} else {
  forma_largo <- "a la izquierda de la mediana"
}

cat("Forma:", forma_largo, "\n")


# Variabilidad
if(cv_largo < 10){
  variabilidad_largo <- "bajo"
} else if(cv_largo <= 30){
  variabilidad_largo <- "moderado"
} else {
  variabilidad_largo <- "alto"
}

cat("Variabilidad:", variabilidad_largo, "\n")

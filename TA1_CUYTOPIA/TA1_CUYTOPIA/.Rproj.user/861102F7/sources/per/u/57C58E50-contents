**Limpieza y análisis de la variable Sexo**

```{r}
# ----------------------------------------
# 1. LIMPIEZA DE LA VARIABLE SEXO
# ----------------------------------------

# Convertimos todo a minúsculas para evitar diferencias por formato
DF <- DF %>%
  mutate(Sexo = tolower(Sexo))

# Reemplazamos las distintas formas incorrectas por valores estándar
DF <- DF %>%
  mutate(Sexo = case_when(
    # Variantes de hembra
    Sexo %in% c("h", "hembra") ~ "Hembra",
    
    # Variantes de macho
    Sexo %in% c("m", "macho") ~ "Macho",
    
    # Corrección de errores de tipeo (ej: "machoo", "mmachoo", etc.)
    grepl("mach", Sexo) ~ "Macho",
    grepl("hemb", Sexo) ~ "Hembra",
    
    # Si queda algún valor raro → lo convertimos en NA
    TRUE ~ NA_character_
  ))

# ----------------------------------------
# 2. VERIFICACIÓN DE LA LIMPIEZA
# ----------------------------------------

# Tabla de frecuencias para comprobar que solo hay dos categorías
table(DF$Sexo)


# ----------------------------------------
# 3. CÁLCULO DE DESCRIPTORES
# ----------------------------------------

# Moda (categoría más frecuente)
moda_sexo <- names(sort(table(DF$Sexo), decreasing = TRUE))[1]
moda_sexo

# Cantidad de valores diferentes
valores_diferentes <- length(unique(DF$Sexo))
valores_diferentes

# Tamaño efectivo (cantidad de datos no faltantes)
tamano_efectivo <- sum(!is.na(DF$Sexo))
tamano_efectivo
```


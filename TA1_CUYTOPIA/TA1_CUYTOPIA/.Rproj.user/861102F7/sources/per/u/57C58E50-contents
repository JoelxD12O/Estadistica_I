# Limpieza y análisis de la variable Talla

# ----------------------------------------

```{r}

# ----------------------------------------
# 1. RANGO
# ----------------------------------------

# Se calcula el mínimo y máximo
min_edad <- min(DF$Edad, na.rm = TRUE)
max_edad <- max(DF$Edad, na.rm = TRUE)

# Rango = max - min
rango_edad <- max_edad - min_edad

cat("Rango:", rango_edad, "\n")


# ----------------------------------------
# 2. RANGO INTERCUARTIL (IQR)
# ----------------------------------------

# Se obtienen los cuartiles
cuartiles_edad <- quantile(DF$Edad, na.rm = TRUE)

# Q1 y Q3
Q1_edad <- cuartiles_edad[2]
Q3_edad <- cuartiles_edad[4]

# IQR = Q3 - Q1
iqr_edad <- Q3_edad - Q1_edad

cat("Rango intercuartil:", iqr_edad, "\n")


# ----------------------------------------
# 3. COEFICIENTE DE VARIACIÓN
# ----------------------------------------

# Promedio y desviación estándar
promedio_edad <- mean(DF$Edad, na.rm = TRUE)
desv_edad <- sd(DF$Edad, na.rm = TRUE)

# CV = (sd / mean) * 100
cv_edad <- (desv_edad / promedio_edad) * 100

cat("Coeficiente de variación:", round(cv_edad, 2), "%\n")


# ----------------------------------------
# 4. INTERPRETACIÓN
# ----------------------------------------

# Forma de la distribución
if(abs(promedio_edad - median(DF$Edad, na.rm = TRUE)) < 1){
  forma <- "aproximadamente simétrica"
} else if(promedio_edad > median(DF$Edad, na.rm = TRUE)){
  forma <- "sesgada a la derecha"
} else {
  forma <- "sesgada a la izquierda"
}

cat("Forma de la distribución:", forma, "\n")


# Variabilidad según CV
if(cv_edad < 10){
  variabilidad <- "baja"
} else if(cv_edad <= 30){
  variabilidad <- "moderada"
} else {
  variabilidad <- "alta"
}

cat("Variabilidad:", variabilidad, "\n")

```


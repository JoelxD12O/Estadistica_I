tamano_efectivo_edad
# ----------------------------------------
# 1. DETECCIÓN DE VALORES ATÍPICOS
# ----------------------------------------
# Se identifican los valores atípicos usando el boxplot
outliers_edad <- boxplot.stats(DF$Edad)$out
# Se cuenta cuántos valores atípicos hay
cantidad_outliers_edad <- length(outliers_edad)
cat("Cantidad de valores atípicos:", cantidad_outliers_edad, "\n")
# ----------------------------------------
# 2. DETECCIÓN DE VALORES NO ENTEROS
# ----------------------------------------
# Se identifican los valores que no son enteros (error según enunciado)
no_enteros <- DF$Edad[!is.na(DF$Edad) & DF$Edad %% 1 != 0]
# Se cuenta cuántos valores no enteros existen
cantidad_no_enteros <- length(no_enteros)
cat("Cantidad de valores no enteros:", cantidad_no_enteros, "\n")
# ----------------------------------------
# 3. LIMPIEZA
# ----------------------------------------
# Se reemplazan por NA los valores que:
# - están fuera del rango (8 a 72)
# - no son enteros
DF$Edad <- ifelse(
DF$Edad < 8 | DF$Edad > 72 | DF$Edad %% 1 != 0,
NA,
DF$Edad
)
# ----------------------------------------
# 4. VERIFICACIÓN
# ----------------------------------------
# Se genera un boxplot después de la limpieza
boxplot(DF$Edad, main = "Edad después de limpieza")
# ----------------------------------------
# 5. DESCRIPTORES

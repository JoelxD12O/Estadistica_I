median_edad <- median(DF$Edad, na.rm = TRUE)
max_edad <- max(DF$Edad, na.rm = TRUE)
promedio_edad <- mean(DF$Edad, na.rm = TRUE)
desv_edad <- sd(DF$Edad, na.rm = TRUE)
cat("Mínimo:", min_edad, "\n")
cat("Mediana:", median_edad, "\n")
cat("Máximo:", max_edad, "\n")
cat("Promedio:", promedio_edad, "\n")
cat("Desviación estándar:", desv_edad, "\n")

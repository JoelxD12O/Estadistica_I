# ----------------------------------------
boxplot(DF$Edad, main = "Edad después de limpieza")
# ----------------------------------------
# 5. DESCRIPTORES
# ----------------------------------------
min_edad <- min(DF$Edad, na.rm = TRUE)
median_edad <- median(DF$Edad, na.rm = TRUE)
max_edad <- max(DF$Edad, na.rm = TRUE)
promedio_edad <- mean(DF$Edad, na.rm = TRUE)
desv_edad <- sd(DF$Edad, na.rm = TRUE)
min_edad
median_edad
max_edad
promedio_edad
desv_edad

# ----------------------------------------
# 1. LIMPIEZA
# ----------------------------------------
# Pasamos todo a minúsculas para evitar errores
DF$Talla <- tolower(DF$Talla)
# Corregimos errores comunes (teclado fallando: o, m, etc.)
DF$Talla <- ifelse(grepl("flac", DF$Talla), "flaco", DF$Talla)
DF$Talla <- ifelse(grepl("san", DF$Talla), "sano", DF$Talla)
DF$Talla <- ifelse(grepl("gord", DF$Talla), "gordo", DF$Talla)
DF$Talla <- ifelse(grepl("obes", DF$Talla), "obeso", DF$Talla)
# Valores inválidos → NA
DF$Talla <- ifelse(
DF$Talla %in% c("flaco", "sano", "gordo", "obeso"),
DF$Talla,
NA
)
# ----------------------------------------
# 2. CONVERTIR A VARIABLE ORDINAL
# ----------------------------------------
DF$Talla <- factor(
DF$Talla,
levels = c("flaco", "sano", "gordo", "obeso"),
ordered = TRUE
)
# ----------------------------------------
# 3. VERIFICACIÓN
# ----------------------------------------
table(DF$Talla)
# ----------------------------------------
# 4. DESCRIPTORES
# ----------------------------------------
# Moda
moda_talla <- names(sort(table(DF$Talla), decreasing = TRUE))[1]
# Cantidad de valores diferentes
valores_talla <- length(unique(DF$Talla))
cat("Moda:", moda_talla, "\n")
cat("Cantidad de valores diferentes:", valores_talla, "\n")
# ----------------------------------------
# 5. TAMAÑO EFECTIVO
# ----------------------------------------
tamano_efectivo_talla <- sum(!is.na(DF$Talla))
cat("Tamaño efectivo:", tamano_efectivo_talla, "\n")
# ----------------------------------------
# 6. CUARTILES (IMPORTANTE)
# ----------------------------------------
# Como es ordinal, R sí puede calcular cuantiles
cuartiles <- quantile(as.numeric(DF$Talla), na.rm = TRUE)
# Convertimos a etiquetas
niveles <- levels(DF$Talla)
Q1 <- niveles[cuartiles[2]]
Q2 <- niveles[cuartiles[3]]
Q3 <- niveles[cuartiles[4]]
cat("Primer cuartil:", Q1, "\n")
cat("Segundo cuartil (mediana):", Q2, "\n")
cat("Tercer cuartil:", Q3, "\n")
# ----------------------------------------
# 1. LIMPIEZA
# ----------------------------------------
# Pasamos todo a minúsculas para evitar errores
DF$Talla <- tolower(DF$Talla)
# Corregimos errores comunes (teclado fallando: o, m, etc.)
DF$Talla <- ifelse(grepl("flac", DF$Talla), "flaco", DF$Talla)
DF$Talla <- ifelse(grepl("san", DF$Talla), "sano", DF$Talla)
DF$Talla <- ifelse(grepl("gord", DF$Talla), "gordo", DF$Talla)
DF$Talla <- ifelse(grepl("obes", DF$Talla), "obeso", DF$Talla)
# Valores inválidos → NA
DF$Talla <- ifelse(
DF$Talla %in% c("flaco", "sano", "gordo", "obeso"),
DF$Talla,
NA
)
# ----------------------------------------
# 2. CONVERTIR A VARIABLE ORDINAL
# ----------------------------------------
DF$Talla <- factor(
DF$Talla,
levels = c("flaco", "sano", "gordo", "obeso"),
ordered = TRUE
)
# ----------------------------------------
# 3. VERIFICACIÓN
# ----------------------------------------
table(DF$Talla)
# ----------------------------------------
# 4. DESCRIPTORES
# ----------------------------------------
# Moda
moda_talla <- names(sort(table(DF$Talla), decreasing = TRUE))[1]
# Cantidad de valores diferentes
valores_talla <- length(unique(na.omit(DF$Talla)))
cat("Moda:", moda_talla, "\n")
cat("Cantidad de valores diferentes:", valores_talla, "\n")
# ----------------------------------------
# 5. TAMAÑO EFECTIVO
# ----------------------------------------
tamano_efectivo_talla <- sum(!is.na(DF$Talla))
cat("Tamaño efectivo:", tamano_efectivo_talla, "\n")
# ----------------------------------------
# 6. CUARTILES (IMPORTANTE)
# ----------------------------------------
# Como es ordinal, R sí puede calcular cuantiles
cuartiles <- quantile(as.numeric(DF$Talla), na.rm = TRUE)
# Convertimos a etiquetas
niveles <- levels(DF$Talla)
Q1 <- niveles[cuartiles[2]]
Q2 <- niveles[cuartiles[3]]
Q3 <- niveles[cuartiles[4]]
cat("Primer cuartil:", Q1, "\n")
cat("Segundo cuartil (mediana):", Q2, "\n")
cat("Tercer cuartil:", Q3, "\n")
# ----------------------------------------
# 1. RANGO
# ----------------------------------------
# Se calcula el mínimo y máximo
min_edad <- min(DF$Edad, na.rm = TRUE)
max_edad <- max(DF$Edad, na.rm = TRUE)
# Rango = max - min
rango_edad <- max_edad - min_edad
cat("Rango:", rango_edad, "\n")
# ----------------------------------------
# 2. RANGO INTERCUARTIL (IQR)
# ----------------------------------------
# Se obtienen los cuartiles
cuartiles_edad <- quantile(DF$Edad, na.rm = TRUE)
# Q1 y Q3
Q1_edad <- cuartiles_edad[2]
Q3_edad <- cuartiles_edad[4]
# IQR = Q3 - Q1
iqr_edad <- Q3_edad - Q1_edad
cat("Rango intercuartil:", iqr_edad, "\n")
# ----------------------------------------
# 3. COEFICIENTE DE VARIACIÓN
# ----------------------------------------
# Promedio y desviación estándar
promedio_edad <- mean(DF$Edad, na.rm = TRUE)
desv_edad <- sd(DF$Edad, na.rm = TRUE)
# CV = (sd / mean) * 100
cv_edad <- (desv_edad / promedio_edad) * 100
cat("Coeficiente de variación:", round(cv_edad, 2), "%\n")
# ----------------------------------------
# 4. INTERPRETACIÓN
# ----------------------------------------
# Forma de la distribución
if(abs(promedio_edad - median(DF$Edad, na.rm = TRUE)) < 1){
forma <- "aproximadamente simétrica"
} else if(promedio_edad > median(DF$Edad, na.rm = TRUE)){
forma <- "sesgada a la derecha"
} else {
forma <- "sesgada a la izquierda"
}
cat("Forma de la distribución:", forma, "\n")
# Variabilidad según CV
if(cv_edad < 10){
variabilidad <- "baja"
} else if(cv_edad <= 30){
variabilidad <- "moderada"
} else {
variabilidad <- "alta"
}
cat("Variabilidad:", variabilidad, "\n")
